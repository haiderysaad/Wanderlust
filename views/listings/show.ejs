<% layout("/layouts/boilerplate") %>
    new mapboxgl.Marker()
        .setLngLat(listing.geometry.coordinates)
        .setPopup(new mapboxgl.Popup({offset: 25})
        .setHTML(`<h6>${listing.title}</h6><p>${listing.location}</p>`))
        .addTo(map);
</script>

<div class="row mt-3 justify-content-center">
    <div class="col-8">
        <h3 class="text-center mb-3"><%=listing.title%></h3>

        <div class="card show-card">
            <img src="<%= listing.image?.url || 'https://via.placeholder.com/400' %>" class="show-img">
            <div class="card-body p-3">
                <i>Hosted by <%= listing.owner?.username || "Wanderlust community" %></i>
                <p class="card-text"><%=listing.description%></p>
                <p class="card-text"><strong>&#8377;<%= listing.price?.toLocaleString("en-IN") || "0" %></strong> / night</p>
                <p class="card-text"><%=listing.location%>, <%=listing.country%></p>
                <p class="card-text"><strong>Category:</strong> <%= categories.find(category => category.value === (listing.category || "rooms")).label %></p>
            </div>
        </div>

    <%if(currUser&&listing.owner&&listing.owner._id.equals(currUser._id)){%>
        <div class="d-flex gap-2 mt-3">
            <a href="/listings/<%=listing._id%>/edit" class="btn btn-danger">Edit</a>
            <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE">
                <button class="btn btn-dark">Delete</button>
            </form>
        </div>
    <%}%>

        <hr/>

        <%if(currUser){%>
        <h4 class="mt-4 mb-3">Leave a Review</h4>
        <form action="/listings/<%=listing._id%>/reviews" method="POST" novalidate class="needs-validation">
            <fieldset class="starability-slot">
                <legend>Rating:</legend>
                <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                <label for="first-rate1" title="Terrible">1 star</label>
                <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                <label for="first-rate2" title="Not good">2 stars</label>
                <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                <label for="first-rate3" title="Average">3 stars</label>
                <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                <label for="first-rate4" title="Very good">4 stars</label>
                <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                <label for="first-rate5" title="Amazing">5 stars</label>
            </fieldset>
            <div class="mb-3">
                <label for="comment" class="form-label">Comments</label>
                <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control" required></textarea>
                <div class="invalid-feedback">Please add a comment before submitting.</div>
            </div>
            <button class="btn btn-outline-dark">Submit</button>
        </form>
        <% } %>
        <hr/>

        <% if(listing.reviews.length > 0){ %>
            <h4 class="mb-3">All Reviews</h4>
            <div class="row row-cols-2 g-3 mb-4">
                <% for(let review of listing.reviews){ %>
                    <div class="col">
                        <div class="review-card">
                            <div class="review-header">
                                <div class="reviewer-avatar">
                                    <%= review.author ? review.author.username[0].toUpperCase() : "A" %>
                                </div>
                                <%= review.author ? review.author.username : "Anonymous" %>
                            </div>
                            <p class="starability-result" data-rating="<%= review.rating %>">
    Rated: <%= review.rating %> stars
</p>
                            <p class="review-comment">"<%=review.comment%>"</p>
                        <% if(currUser && review.author && review.author._id.equals(currUser._id)){ %>
                            <form method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE" class="mt-2">
                                <button class="btn btn-sm btn-outline-danger">Delete</button>
                            </form>
                        <% } %>
                        </div>
                    </div>
                <% } %>
            </div>
        <% } else { %>
            <p class="text-muted">No reviews yet. Be the first to review!</p>
        <% } %>

    </div>
    <div class="col-8 offset-3 mb-3">
        <h3>Where You Will be</h3>
        <div id="map" style="width:100%; height:300px;"></div>
    </div>
    <script>
    const mapToken = "<%- mapToken %>";
    const listing = <%- JSON.stringify(listing) %>;
</script>
<script src="/js/map.js"></script>
</div>
<script src="/js/map.js"></script>
