<% layout("/layouts/boilerplate") %>

<section class="listing-explorer">
    <div class="category-bar" aria-label="Browse stay categories">
        <% for (let category of categories) { %>
            <a
                class="category-filter <%= currentCategory === category.value ? 'active' : '' %>"
                href="/listings?category=<%= category.value %><%= searchTerm ? '&q=' + encodeURIComponent(searchTerm) : '' %>"
                aria-current="<%= currentCategory === category.value ? 'page' : 'false' %>"
            >
                <i class="fa-solid <%= category.icon %>" aria-hidden="true"></i>
                <span><%= category.label %></span>
            </a>
        <% } %>
    </div>

    <div class="listing-toolbar">
        <p class="listing-count"><strong><%= alllisting.length %></strong> stays to explore</p>
        <div class="tax-toggle">
            <div class="form-check form-check-reverse form-switch">
                <input class="form-check-input" type="checkbox" role="switch" id="switchCheckDefault">
                <label class="form-check-label" for="switchCheckDefault">Display total after taxes (18% GST)</label>
            </div>
        </div>
    </div>

    <% if (alllisting.length) { %>
        <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 g-4">
            <% for (let listing of alllisting) { %>
                <div class="col">
                    <article class="listing-card">
                        <a class="listing-image-link" href="/listings/<%= listing._id %>">
                            <img
                                src="<%= listing.image?.url || 'https://via.placeholder.com/800x600?text=Stay+Image' %>"
                                class="card-img-top"
                                alt="<%= listing.title %>"
                                loading="lazy"
                            >
                            <% if (listing.featured) { %>
                                <span class="featured-badge"><i class="fa-solid fa-fire"></i> Trending</span>
                            <% } %>
                        </a>
                        <div class="listing-card-details">
                            <div class="listing-card-heading">
                                <h2><a href="/listings/<%= listing._id %>"><%= listing.title %></a></h2>
                                <span class="listing-category"><%= categories.find(category => category.value === (listing.category || "rooms")).label %></span>
                            </div>
                            <p class="listing-location"><%= listing.location %>, <%= listing.country %></p>
                            <p class="listing-price">
                                <span class="price-before-tax"><strong>₹<%= (listing.price || 0).toLocaleString("en-IN") %></strong> / night</span>
                                <span class="price-after-tax"><strong>₹<%= Math.round((listing.price || 0) * 1.18).toLocaleString("en-IN") %></strong> / night (incl. 18% GST)</span>
                            </p>
                        </div>
                    </article>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <div class="empty-listings">
            <i class="fa-regular fa-compass" aria-hidden="true"></i>
            <h2>No stays found</h2>
            <p>Try another category or search for a different destination.</p>
            <a class="btn btn-dark" href="/listings">Explore all stays</a>
        </div>
    <% } %>
</section>

<script>
    const taxSwitch = document.getElementById("switchCheckDefault");
    taxSwitch.addEventListener("change", () => {
        document.querySelector(".listing-explorer").classList.toggle("tax-inclusive", taxSwitch.checked);
    });
</script>
